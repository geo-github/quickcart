# Copy this file to .env and fill in the two confidential values.
# .env is git-ignored. Never commit it, paste it into chat, or put the values in code or docs.

# --- Training LLM platform (ask your group leader; keep confidential) ---
# Base URL ending in /v1. The chat endpoint is <LLM_BASE_URL>/chat/completions.
LLM_BASE_URL=http://llm-platform-alb-1231835738.us-east-1.elb.amazonaws.com/v1
# The access key, sent as the x-bf-vk request header.
LLM_API_KEY=sk-bf-d8f735de-72ae-405b-b0b2-aba1539358c6

LLM_MAIN=vllm/mistralai/Mistral-7B-Instruct-v0.3
LLM_LIGHT=ollama/gemma2:2b
EMBED_MODEL=ollama/nomic-embed-text

# live | record | replay | cache   (the platform runs 11:00-21:00 only; outside it use replay)
LLM_MODE=live
# Set these two from the Day 1 smoke test: python tools/smoke_test.py
TOOL_MODE=native
JSON_MODE=schema
LLM_AUTO_FALLBACK=true
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
LLM_CACHE_DIR=./var/llm_cache

# --- Storage ---
DB_PATH=./var/app.db
CHROMA_PATH=./var/chroma

# --- Agent limits and memory ---
MAX_TURNS=8
MAX_STEPS=12
SESSION_TOKEN_BUDGET=60000
HISTORY_TOKEN_BUDGET=3000

# --- Feature switches ---
ENABLE_ORCHESTRATOR=true
# false for the "before" evaluation numbers (W4)
GUARDS_ENABLED=true
# inprocess | mcp (Team 3 stretch goal)
TOOL_TRANSPORT=inprocess
